{
  // The Next.js app builds to `out/` (see next.config.ts `output: "export"`).
  // A thin Worker script (worker/index.js) serves those static files via the
  // ASSETS binding and adds one extra thing: a weekly cron job that emails a
  // visitor report. If that worker/index.js file is ever removed, drop
  // "main" and "triggers" below and this goes back to pure static hosting.
  "name": "labs-academy",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Without this, Cloudflare serves 404s for unmatched paths straight from
    // the assets layer and never calls worker/index.js's fetch() — which is
    // what our /__trigger-weekly-report-x7f2q9 test route needs to run.
    "run_worker_first": true
  },
  "triggers": {
    // Monday 00:00 UTC = Monday 09:00 KST.
    "crons": ["0 0 * * 1"]
  }
}
